# Порт, на котором слушает бэкенд
PORT=3000

# Путь к файлу базы SQLite.
# Локально — внутри проекта, на сервере — /var/lib/dog-walks/walks.db
DB_PATH=./database/walks.db

# Языковая модель для разбора периода.
# Протокол OpenAI-совместимый. Для Yandex AI Studio:
#   LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
#   LLM_MODEL=gpt://<id-каталога>/<модель>/latest
# Без этих переменных кнопка разбора просто не показывается.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Параметры генерации. Вынесены в окружение, чтобы подкручивать их
# правкой .env и `pm2 reload`, без выкатки кода.
#
# LLM_MAX_TOKENS — потолок длины ответа. Мало — модель обрывает фразу
# на полуслове, а рассуждающие модели вроде DeepSeek и вовсе не доходят
# до текста и возвращают пустой content.
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2500

# Файл с системным промптом. По умолчанию берётся prompts/report-system.md
# из репозитория. Указывать эту переменную нужно только для подбора
# формулировок прямо на сервере: деплой делает git reset --hard, и правка
# файла внутри репозитория не переживёт следующую выкатку.
#   LLM_PROMPT_FILE=/var/lib/dog-walks/report-system.md
LLM_PROMPT_FILE=
